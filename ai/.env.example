# ai/.env 로 복사해서 사용 (.env는 커밋 금지)

# 프론트 주소 (쉼표로 여러 개). 기본: 로컬 개발 서버 + Vercel 배포 주소
ALLOWED_ORIGINS=http://localhost:5173,https://aleph-capstone.vercel.app

# 장소 목록 위치를 바꿀 때만 (기본: 저장소의 shared/places.json)
# PLACES_PATH=../shared/places.json

# OpenAI API 키 (없으면 키워드 규칙으로 추천)
LLM_API_Key=
# 쓸 모델 (기본 gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# 한국관광공사 국문 관광정보 서비스 (공공데이터포털 Decoding 키) — 아직 코드에서 안 씀
TOUR_API_KEY=

# 카카오 맵 REST API 키 — 아직 코드에서 안 씀
KAKAO_REST_API_KEY=

