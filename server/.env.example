# server/.env 로 복사해서 값을 채운다. .env는 절대 커밋하지 않는다 (저장소 public)
# 값 위치: Supabase 대시보드 → Project Settings → API Keys / Data API

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# publishable 키(sb_publishable_...) 또는 예전 anon 키. 공개돼도 RLS가 막는 키
# secret / service_role 키는 넣지 않는다 (RLS를 전부 무시하는 키)
SUPABASE_PUBLISHABLE_KEY=

# 화면 주소 (쉼표로 구분). 여기 없는 주소의 브라우저 요청은 CORS로 막힘
ALLOWED_ORIGINS=http://localhost:5173,https://aleph-capstone.vercel.app

PORT=4000
